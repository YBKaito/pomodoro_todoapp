{
  "name": "todoy",
  "version": "1.1.0",
  "description": "A desktop task board and Pomodoro companion",
  "main": "src/main.cjs",
  "author": "YBKaito",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:win": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.ybkaito.todoy",
    "productName": "ToDoY",
    "files": [
      "src/**/*",
      "assests/ToDoY.ico",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assests/ToDoY.ico",
      "target": "portable"
    },
    "portable": {
      "artifactName": "ToDoY-${version}-Windows.exe"
    }
  }
}
