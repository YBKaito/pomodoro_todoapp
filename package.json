{
  "name": "focus-dock",
  "version": "1.1.0",
  "description": "A desktop task board and Pomodoro companion",
  "main": "src/main.cjs",
  "author": "YBKaito",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:win": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.ybkaito.focusdock",
    "productName": "Focus Dock",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "Focus-Dock-${version}-Windows.exe"
    }
  }
}
